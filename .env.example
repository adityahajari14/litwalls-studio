# Litwalls Studio — copy to .env.local and fill in.
# See README.md for where each value comes from.
#
# .env.local is gitignored. Nothing here is read from the storefront project;
# Studio is self-contained.

# ─── Shopify ────────────────────────────────────────────────────────────────
# Same store as the storefront, e.g. your-shop.myshopify.com
SHOPIFY_STORE_DOMAIN=

# NOT the storefront's Admin token. This one needs write_products and
# read_products on top of write_files.
#
# ⚠ Adding those scopes makes Shopify issue a NEW token and the old one stops
#   working immediately. The storefront uses that token for custom-poster
#   uploads, so paste the new value into BOTH litwalls/.env.local and this
#   file in the same sitting — otherwise custom poster uploads break silently
#   until a customer tries one.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Public-scope, read-only. Used to list existing product titles when working
# out the next free sequence number. Safe to copy from the storefront as-is.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optional. The Headless/Storefront sales channel publication id. Discovered
# and cached on first publish if left blank.
SHOPIFY_PUBLICATION_ID=

# ─── Gemini ─────────────────────────────────────────────────────────────────
# Used for subject identification and focal-point detection. Studio works
# without it — jobs fall back to a filename-derived subject and a centre crop,
# badged in the review UI so you know to look.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ─── Google Drive ───────────────────────────────────────────────────────────
# OAuth client for an installed app. Redirect URI must be exactly:
#   http://localhost:3000/api/drive/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional. The Drive folder everything is filed under. Created if blank.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
